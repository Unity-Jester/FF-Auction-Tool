# Optional account sync. Leave the entire group empty for guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_CAPTCHA_SITE_KEY=

# Optional shared rate limiting. Configure both values together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional independent HMAC key for anonymized shared limiter keys.
# If empty, the Upstash token is used; local-only mode uses a process key.
RATE_LIMIT_KEY_SECRET=

# Optional trusted-proxy settings. Enable only for the matching deployment.
TRUST_PROXY=
TRUST_CLOUDFLARE=

# Development and automated testing only. Production always ignores this flag.
E2E_FIXTURES=
